# Jarvis runtime config — the Halloween skull, as actually tuned.
#
# The live copy lives at ~/.config/jarvis/jarvis.env on the Pi (chmod 600) and
# is read by the systemd service. This checked-in version exists so the config
# survives an SD-card failure — SECRETS ARE REDACTED, fill them in by hand.
#
# For manual runs, load it instead of duplicating settings into ~/.bashrc:
#     set -a; source ~/.config/jarvis/jarvis.env; set +a
#
# ⚠️ Add each key ONCE. Duplicate lines put a newline into the value and break
#    HTTP headers (seen as `curl: (43) bad argument`). Check with:
#     grep -c ELEVENLABS ~/.config/jarvis/jarvis.env

# ─── Secrets — never commit real values ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REDACTED
JARVIS_ELEVENLABS_KEY=sk_REDACTED

# ─── Character ───────────────────────────────────────────────────────────────
JARVIS_PERSONA=skull
JARVIS_CLAUDE_MODEL=claude-haiku-4-5      # fastest; latency is felt live
JARVIS_BARKER_GENERATE=true               # fresh call-out lines each boot
JARVIS_BARKER_COUNT=20

# ─── Toilet-flush banter (bathroom installs) ─────────────────────────────────
# Off by default. Thresholds MUST be tuned in the real room — tiled bathrooms
# are acoustically brutal. Run `python jarvis.py --test-flush` while flushing,
# then again while talking, and set values between the two readings.
#JARVIS_FLUSH_ENABLED=true
#JARVIS_FLUSH_MIN_S=2.5                   # a flush runs for seconds; a word doesn't
#JARVIS_FLUSH_RMS=600                     # must be louder than the room
#JARVIS_FLUSH_FLATNESS=0.15               # ~0 = harmonic voice, ->1 = broadband water
#JARVIS_FLUSH_SUSTAINED=0.8               # speech has gaps; a flush doesn't
#JARVIS_FLUSH_GENERATE=true               # fresh comebacks each boot
#JARVIS_FLUSH_COUNT=12

# ─── Trigger ─────────────────────────────────────────────────────────────────
JARVIS_INPUT_MODE=motion                  # presence, no wake word
JARVIS_MOTION_PIN=17                      # PIR OUT -> pin 11
JARVIS_MOTION_COOLDOWN=20
JARVIS_MOTION_FOLLOW_UPS=4

# ─── Audio devices ───────────────────────────────────────────────────────────
JARVIS_AUDIO_DEVICE=0                     # ReSpeaker 4-Mic Array
JARVIS_AUDIO_CHANNELS=6                   # ch0 is the processed channel
JARVIS_AUDIO_OUTPUT=plughw:3,0            # Pebble V3

# ─── Speech recognition ──────────────────────────────────────────────────────
JARVIS_WHISPER_MODEL=tiny.en              # English-only: faster AND more accurate
JARVIS_VAD_SILENCE_MS=700                 # snappier end-of-speech
JARVIS_MAX_DEAD_CAPTURES=3                # audio watchdog sensitivity

# ─── Voice: ElevenLabs primary, piper/alan fallback ──────────────────────────
JARVIS_ELEVENLABS_VOICE=Tj9l48J9AJbry5yCP5eW
JARVIS_ELEVENLABS_TEMPO=1.15              # >1 faster; pitch preserved
JARVIS_PIPER_MODEL=/home/jarvis/piper-voices/en_GB-alan-medium.onnx
JARVIS_PIPER_LENGTH_SCALE=1.2
# NOTE: no JARVIS_PIPER_PITCH — pitch-shifting sounded artificial (it moves the
# formants, so the voice reads as processed rather than deep).

# ─── Ambience ────────────────────────────────────────────────────────────────
JARVIS_AMBIENCE_FILE=/home/jarvis/sounds/graveyard.wav
JARVIS_AMBIENCE_RESUME_S=5                # comes back mid-cooldown, not after

# ─── Servo jaw — MG90S (metal gear), measured with --jog-jaw ─────────────────
JARVIS_JAW_ENABLED=true
JARVIS_SERVO_PIN=18                        # signal -> pin 12, own 5V supply
JARVIS_JAW_CLOSED_ANGLE=5                  # teeth just meet
JARVIS_JAW_OPEN_ANGLE=4                    # cable slack, jaw hangs open
JARVIS_JAW_RATE_HZ=3                       # half default — suits a slow delivery
#
# ⚠️ That 1° working range is real, not a typo. The cable's leverage means the
# whole jaw travel happens in ~1° of servo rotation, so:
#   - the flap's built-in variation is below the servo's deadband, and the jaw
#     reads as binary open/closed rather than varied
#   - servo dither is a large fraction of travel
# It looks fine at party distance. To improve it you need MORE servo rotation
# per unit of jaw movement — move the cable further from the jaw hinge, or
# closer to the horn's centre. A longer horn makes it worse, not better.
# Re-run `python jarvis.py --jog-jaw` after any change to the linkage.
#
# The eyes read JARVIS_JAW_RATE_HZ too, so they pulse in step with the jaw.

# ─── LED eyes ────────────────────────────────────────────────────────────────
JARVIS_EYES_ENABLED=true
#JARVIS_EYES_PIN=23                        # signal -> pin 16, 470Ω per LED
#JARVIS_EYES_IDLE=0.15                     # dim, waiting
#JARVIS_EYES_ALERT=0.6                     # someone's here
#JARVIS_EYES_TALK=1.0                      # peak while speaking

# Without this Python buffers stdout under systemd and journalctl shows nothing
# until 4KB accumulates — the service looks dead when it's actually running.
PYTHONUNBUFFERED=1

# systemd needs piper on PATH
PATH=/home/jarvis/piper:/usr/local/bin:/usr/bin:/bin
