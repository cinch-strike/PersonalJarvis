# Jarvis systemd service (Pi) — run the wake-word assistant 24/7 on boot.
#
# Install:
#   1. Put your env (incl. ANTHROPIC_API_KEY) in ~/.config/jarvis/jarvis.env
#      (see HANDOFF.md "Running 24/7"). chmod 600 it.
#   2. sudo cp this file to /etc/systemd/system/jarvis.service (drop .example)
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now jarvis
#   4. Watch it: journalctl -u jarvis -f
#
# Adjust paths if your username isn't "jarvis".

[Unit]
Description=Jarvis voice assistant
After=network-online.target sound.target
Wants=network-online.target
# Don't give up if the audio watchdog restarts us repeatedly over a long night.
# NOTE: this key belongs in [Unit], not [Service] — systemd silently ignores it
# in the wrong section ("Unknown key ... ignoring").
StartLimitIntervalSec=0

[Service]
Type=simple
User=jarvis
SupplementaryGroups=audio
WorkingDirectory=/home/jarvis/PersonalJarvis/jarvis/phase1
EnvironmentFile=/home/jarvis/.config/jarvis/jarvis.env
ExecStart=/home/jarvis/PersonalJarvis/jarvis/phase1/.venv/bin/python jarvis.py
# The audio watchdog exits non-zero when the mic drops out, so the service must
# restart on failure — that's the self-heal. RestartSec gives USB time to settle.
Restart=on-failure
RestartSec=5
# Without this, Python buffers stdout when it isn't a terminal, so journalctl
# shows nothing until 4KB accumulates — the service looks dead when it's fine.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
